{
  "entity": "Session",
  "version": "1.0",
  "description": "User session tracking and management",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "userId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "User",
        "field": "id",
        "on_delete": "cascade"
      }
    },
    "token": {
      "type": "string",
      "required": true,
      "unique": true,
      "sensitive": true,
      "description": "Session token"
    },
    "expiresAt": {
      "type": "bigint",
      "required": true,
      "description": "Session expiration time"
    },
    "createdAt": {
      "type": "bigint",
      "optional": true,
      "nullable": true
    },
    "lastActivity": {
      "type": "bigint",
      "optional": true,
      "nullable": true
    },
    "ipAddress": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "userAgent": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "tenantId": {
      "type": "string",
      "nullable": true,
      "description": "Tenant scope for multi-tenant routing"
    }
  },
  "indexes": [
    {
      "fields": [
        "token"
      ],
      "unique": true
    },
    {
      "fields": [
        "userId"
      ]
    },
    {
      "fields": [
        "expiresAt"
      ]
    }
  ],
  "relations": {
    "user": {
      "type": "belongs-to",
      "entity": "User",
      "foreign_key": "userId",
      "on_delete": "cascade",
      "description": "User this session belongs to"
    }
  },
  "acl": {
    "create": {
      "system": true
    },
    "read": {
      "system": true
    },
    "update": {
      "system": true
    },
    "delete": {
      "system": true
    }
  }
}