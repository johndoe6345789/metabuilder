{
  "version": "1.0",
  "clients": [
    {
      "client_id": "pastebin-web",
      "client_name": "Pastebin",
      "token_endpoint_auth_method": "none",
      "grant_types": ["authorization_code", "refresh_token"],
      "response_types": ["code"],
      "redirect_uris": [
        "http://localhost:3000/auth/callback"
      ],
      "post_logout_redirect_uris": [
        "http://localhost:3000/"
      ],
      "require_pkce": true,
      "pkce_methods": ["S256"],
      "scope": "openid profile email offline_access",
      "access_token_ttl_seconds": 900,
      "refresh_token_ttl_seconds": 1209600,
      "id_token_ttl_seconds": 900
    },
    {
      "client_id": "dbal-test-client",
      "client_name": "DBAL Internal Test Client",
      "token_endpoint_auth_method": "none",
      "grant_types": ["authorization_code", "refresh_token"],
      "response_types": ["code"],
      "redirect_uris": [
        "http://localhost:8080/test/callback"
      ],
      "post_logout_redirect_uris": [],
      "require_pkce": true,
      "pkce_methods": ["S256"],
      "scope": "openid profile email offline_access",
      "access_token_ttl_seconds": 900,
      "refresh_token_ttl_seconds": 1209600,
      "id_token_ttl_seconds": 900
    }
  ]
}
