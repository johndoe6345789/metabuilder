#!/bin/sh
# Auto-select the correct platform binary for testcontainers-sidecar.
# Supports: macOS ARM64 (M-series), Linux AMD64, Linux ARM64 (Raspberry Pi 5).
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$ARCH" in
  x86_64|amd64) ARCH="amd64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *) echo "testcontainers-sidecar: unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

BIN="$SCRIPT_DIR/testcontainers-sidecar-${OS}-${ARCH}"

if [ ! -x "$BIN" ]; then
  echo "testcontainers-sidecar: binary not found: $BIN" >&2
  echo "  Available:" >&2
  ls "$SCRIPT_DIR"/testcontainers-sidecar-* 2>/dev/null | sed 's/^/    /' >&2
  exit 1
fi

exec "$BIN" "$@"
