{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "./src/lib/quality-validator",
    "outDir": "./src/lib/quality-validator",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "skipLibCheck": true
  },
  "include": ["src/lib/quality-validator/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
