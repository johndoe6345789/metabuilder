FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential g++ cmake unzip ca-certificates socat \
    && rm -rf /var/lib/apt/lists/*
COPY runners/codelldb.vsix /tmp/codelldb.vsix
RUN unzip -q /tmp/codelldb.vsix -d /opt/codelldb \
    && chmod +x /opt/codelldb/extension/adapter/codelldb \
    && rm /tmp/codelldb.vsix
ENV LLDB_DEBUGSERVER_PATH=/opt/codelldb/extension/lldb/bin/lldb-server
WORKDIR /workspace
