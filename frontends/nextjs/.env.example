# Every variable this app reads. Generated by hand from `grep process.env`
# on 2026-09-08; the previous version of this file listed two variables
# (DATABASE_URL, DBAL_NATIVE_PRISMA_TOKEN) that nothing in src/ reads, and
# none of the twenty-two that are. Without DBAL_ADMIN_TOKEN in particular
# signup and the tenant layout change behaviour with no error at all.

# ---- The data layer -------------------------------------------------------

# Where the SERVER side reaches DBAL. Read in this order; the first set wins.
# In the shipped image nginx serves DBAL at /api/dbal from the browser's
# point of view, but server components and API routes talk to it directly.
DBAL_ENDPOINT=http://localhost:8080
# DBAL_API_URL=http://localhost:8080

# Where the BROWSER reaches DBAL. Baked into the bundle at build time
# (NEXT_PUBLIC_), so it cannot be changed on a built image; the Dockerfile
# sets it to /api/dbal so app and DBAL share one origin behind nginx.
NEXT_PUBLIC_DBAL_API_URL=http://localhost:8080

# The operator's token. Attached to every server-side DBAL request: DBAL
# enforces the read ACLs its schemas declare, and User (among others)
# refuses a caller who presents nothing. Without this, tenant-exists.ts
# cannot list users, a brand-new community reads as non-existent, and its
# founder's own panel 404s. deploy/compose.yml defaults it.
DBAL_ADMIN_TOKEN=local-dev-admin-token

# Where a server component reaches THIS app's own API (entity views call
# /api/v1 from the Node process, and Node's fetch takes no relative URL).
# Must match the port the app listens on -- 3000 in the image.
METABUILDER_INTERNAL_URL=http://127.0.0.1:3000/app

# Tenant and package the generic db client falls back to. Leave alone.
# DBAL_DEFAULT_TENANT=system
# DBAL_DEFAULT_PACKAGE=core

# ---- Sign-in ----------------------------------------------------------------

# Where the browser sends the OIDC authorize request. Defaults to /api/dbal,
# which is origin-relative and does NOT carry the /app basePath -- so under
# plain `next dev` with no nginx in front, the login button 404s unless
# this points straight at DBAL.
NEXT_PUBLIC_DBAL_OIDC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DBAL_OIDC_CLIENT_ID=nextjs-web

# ---- One-time setup and the vault -------------------------------------------

# Required by POST /api/setup and /api/bootstrap. Both refuse without it.
SETUP_SECRET=

# The single instance-wide vault password. Guarded at 5 attempts/minute.
VAULT_MASTER_PASSWORD=

# ---- Uploads and media ------------------------------------------------------

# The S3-style object store the asset routes write to (server side).
OBJECT_STORE_URL=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Browser-side origins for uploads, the media daemon and HLS streams.
NEXT_PUBLIC_S3_API_URL=http://localhost:9000
NEXT_PUBLIC_MEDIA_API_URL=http://localhost:8090
NEXT_PUBLIC_MEDIA_HLS_URL=http://localhost:8088

# ---- Everything else --------------------------------------------------------

# Trust cf-connecting-ip for rate limiting. Only set this behind Cloudflare,
# which strips a forged one; anywhere else it is one more header a caller
# can choose, and the limiter keys on it.
# RATE_LIMIT_TRUST_CF_HEADER=true

# GitHub Actions status in the God Panel. Optional.
# GITHUB_TOKEN=

# Must agree with basePath in next.config.ts. Leave alone.
# NEXT_PUBLIC_BASE_PATH=/app
# NEXT_PUBLIC_APP_VERSION=0.1.0
