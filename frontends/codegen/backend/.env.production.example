# Backend Environment Variables (Production)

# Allowed CORS origins
ALLOWED_ORIGINS=*

# Server Port
PORT=5001

# Postgres connection string
DATABASE_URL=host=codegen-db port=5432 dbname=codegen user=codegen password=codegen

# SQL migrations directory
MIGRATIONS_DIR=/app/migrations

# Legacy SQLite database to one-time-migrate from, if present
SQLITE_MIGRATION_PATH=/data/codeforge.db
