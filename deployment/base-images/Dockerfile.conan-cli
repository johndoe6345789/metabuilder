# metabuilder/base-conan-cli
#
# Conan C++ packages for the CLI frontend only (cpr, lua, sol2, nlohmann_json).
# Split out of the former monolithic base-conan-deps so the app pipeline depends
# on a small, fast base instead of a 32GB image.
#
# Build:  docker build -f Dockerfile.conan-cli -t metabuilder/base-conan-cli:latest ../../
# App Dockerfiles:  FROM metabuilder/base-conan-cli:latest

ARG BASE_REGISTRY=metabuilder
FROM ${BASE_REGISTRY}/base-apt:latest

# Install Conan 2 with retry
RUN for i in 1 2 3 4 5; do \
      pip3 install --break-system-packages conan==2.* \
      && break \
      || (echo "pip install failed (attempt $i/5), retrying in $((i*10))s..." && sleep $((i*10))); \
    done

# Detect Conan profile (must run inside the container, not from host cache)
RUN conan profile detect --force

# Route Conan through the pkgrepo proxy/cache when CONAN_REMOTE is set (empty =
# default conancenter). Base builds run with --network=host, so a host URL like
# http://localhost:5002/conan is reachable.
ARG CONAN_REMOTE=""
RUN if [ -n "$CONAN_REMOTE" ]; then \
      conan remote add pkgrepo "$CONAN_REMOTE" --force && \
      conan remote disable conancenter; \
    fi

# ---- CLI frontend ----
COPY frontends/cli/conanfile.txt /deps/cli/conanfile.txt

RUN mkdir -p /tmp/cli-build && \
    for i in 1 2 3 4 5; do \
      conan install /deps/cli/ \
        --output-folder=/tmp/cli-build \
        --build=missing \
        -s build_type=Release \
        -c tools.system.package_manager:mode=install \
      && break \
      || (echo "conan install (cli) failed attempt $i/5, retrying in $((i*10))s..." && sleep $((i*10))); \
    done

# Keep only the Conan package cache in /root/.conan2
RUN rm -rf /tmp/cli-build

LABEL org.metabuilder.image="base-conan-cli" \
      org.metabuilder.description="Pre-built Conan C++ packages (CLI frontend)"
